{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AQRS structured selection contract, format 1",
  "description": "Format only. No selector, admission guard, executor or independent quality evidence is supplied.",
  "oneOf": [
    {"$ref": "#/$defs/registry"},
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/response"},
    {"$ref": "#/$defs/publicSuite"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$"},
    "revision": {"type": "string", "minLength": 1},
    "qualificationTest": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "tested_rule_revision", "evidence_ref"],
      "properties": {
        "status": {"enum": ["PASSED", "FAILED", "NOT_RUN"]},
        "tested_rule_revision": {"type": ["string", "null"], "minLength": 1},
        "evidence_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "if": {"properties": {"status": {"const": "NOT_RUN"}}},
      "then": {"properties": {"tested_rule_revision": {"type": "null"}, "evidence_ref": {"type": "null"}}},
      "else": {"properties": {"tested_rule_revision": {"type": "string"}, "evidence_ref": {"type": "string"}}}
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation_rule_id", "revision", "qualification", "qualification_task_id"],
      "properties": {
        "evaluation_rule_id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/revision"},
        "qualification": {
          "type": "object", "additionalProperties": false,
          "required": ["known_answer", "null_case"],
          "properties": {
            "known_answer": {"$ref": "#/$defs/qualificationTest"},
            "null_case": {"$ref": "#/$defs/qualificationTest"}
          }
        },
        "qualification_task_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      }
    },
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "description", "state", "evaluation_rule_id", "current_action_id", "blocks", "outcome_actions"],
      "properties": {
        "question_id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "state": {"enum": ["OPEN", "RESOLVED", "DEFERRED"]},
        "evaluation_rule_id": {"$ref": "#/$defs/id"},
        "current_action_id": {"$ref": "#/$defs/id"},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
        "outcome_actions": {
          "type": "object", "additionalProperties": false,
          "required": ["SUPPORTED", "REFUTED", "INCONCLUSIVE", "EXECUTION_ERROR"],
          "properties": {
            "SUPPORTED": {"$ref": "#/$defs/id"},
            "REFUTED": {"$ref": "#/$defs/id"},
            "INCONCLUSIVE": {"$ref": "#/$defs/id"},
            "EXECUTION_ERROR": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "registry": {
      "type": "object", "additionalProperties": false,
      "required": ["document_type", "format_version", "registry_id", "revision", "evidence_mode", "notice", "actions", "evaluation_rules", "questions"],
      "properties": {
        "document_type": {"const": "QUESTION_REGISTRY"},
        "format_version": {"const": 1},
        "registry_id": {"$ref": "#/$defs/id"},
        "revision": {"$ref": "#/$defs/revision"},
        "evidence_mode": {"enum": ["PUBLIC_ASSUMPTIONS", "VERIFIED_RECORDS"]},
        "notice": {"type": "string"},
        "actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "evaluation_rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}},
        "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plan_id", "kind", "target_id", "wall_seconds_bound", "admission_status", "admission_reason", "evidence_ref"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["WORKFLOW_TEST", "RULE_QUALIFICATION"]},
        "target_id": {"$ref": "#/$defs/id"},
        "wall_seconds_bound": {"type": "integer", "minimum": 1},
        "admission_status": {"enum": ["ALLOW", "BLOCK"]},
        "admission_reason": {"enum": ["ALLOWED", "RESEARCH_STOP", "DATA_POLICY_DENIED", "VARIANT_LIMIT", "OUTSIDE_SCOPE", "RULE_FIXTURE_UNAVAILABLE"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      },
      "if": {"properties": {"admission_status": {"const": "ALLOW"}}},
      "then": {"properties": {"admission_reason": {"const": "ALLOWED"}}},
      "else": {"properties": {"admission_reason": {"not": {"const": "ALLOWED"}}}}
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "question_id", "plan_id"],
      "properties": {
        "proposal_id": {"$ref": "#/$defs/id"},
        "question_id": {"$ref": "#/$defs/id"},
        "plan_id": {"$ref": "#/$defs/id"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["document_type", "format_version", "request_id", "policy_version", "registry_id", "registry_revision", "snapshot_id", "authorization_scope", "research_runs_permitted", "remaining_wall_seconds", "plans", "proposals"],
      "properties": {
        "document_type": {"const": "SELECTION_REQUEST"},
        "format_version": {"const": 1},
        "request_id": {"$ref": "#/$defs/id"},
        "policy_version": {"const": "STRUCTURED_SELECTION_V1"},
        "registry_id": {"$ref": "#/$defs/id"},
        "registry_revision": {"$ref": "#/$defs/revision"},
        "snapshot_id": {"$ref": "#/$defs/id"},
        "authorization_scope": {"const": "ENGINEERING_CHECKS_ONLY"},
        "research_runs_permitted": {"const": false},
        "remaining_wall_seconds": {"type": "integer", "minimum": 0},
        "plans": {"type": "array", "items": {"$ref": "#/$defs/plan"}},
        "proposals": {"type": "array", "items": {"$ref": "#/$defs/proposal"}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["document_type", "format_version", "request_id", "policy_version", "registry_id", "registry_revision", "status", "selected_proposal_id", "qualification_task_id", "reason_code"],
      "properties": {
        "document_type": {"const": "SELECTION_RESPONSE"},
        "format_version": {"const": 1},
        "request_id": {"$ref": "#/$defs/id"},
        "policy_version": {"const": "STRUCTURED_SELECTION_V1"},
        "registry_id": {"$ref": "#/$defs/id"},
        "registry_revision": {"$ref": "#/$defs/revision"},
        "status": {"enum": ["SELECT", "QUALIFY_RULE", "STOP", "REJECT_INPUT"]},
        "selected_proposal_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "qualification_task_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "reason_code": {"enum": ["BLOCKING_QUESTION_FIRST", "LOWEST_BOUNDED_COST", "STABLE_ID_TIEBREAK", "RULE_QUALIFICATION_REQUIRED", "NO_DECISION_CHANGING_PROPOSAL", "NO_ADMISSIBLE_WORK", "INVALID_REQUEST"]}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "SELECT"}}}, "then": {"properties": {"selected_proposal_id": {"type": "string"}, "qualification_task_id": {"type": "null"}, "reason_code": {"enum": ["BLOCKING_QUESTION_FIRST", "LOWEST_BOUNDED_COST", "STABLE_ID_TIEBREAK"]}}}},
        {"if": {"properties": {"status": {"const": "QUALIFY_RULE"}}}, "then": {"properties": {"selected_proposal_id": {"type": "null"}, "qualification_task_id": {"type": "string"}, "reason_code": {"const": "RULE_QUALIFICATION_REQUIRED"}}}},
        {"if": {"properties": {"status": {"const": "STOP"}}}, "then": {"properties": {"selected_proposal_id": {"type": "null"}, "qualification_task_id": {"type": "null"}, "reason_code": {"enum": ["NO_DECISION_CHANGING_PROPOSAL", "NO_ADMISSIBLE_WORK"]}}}},
        {"if": {"properties": {"status": {"const": "REJECT_INPUT"}}}, "then": {"properties": {"selected_proposal_id": {"type": "null"}, "qualification_task_id": {"type": "null"}, "reason_code": {"const": "INVALID_REQUEST"}}}}
      ]
    },
    "publicCase": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "description", "expected_format_valid", "request", "expected_response"],
      "properties": {
        "case_id": {"$ref": "#/$defs/id"},
        "description": {"type": "string", "minLength": 1},
        "expected_format_valid": {"type": "boolean"},
        "request": {"type": "object", "description": "Validate separately as a request; one public case intentionally violates that schema."},
        "expected_response": {"$ref": "#/$defs/response"}
      }
    },
    "publicSuite": {
      "type": "object", "additionalProperties": false,
      "required": ["document_type", "format_version", "notice", "registry_file", "cases"],
      "properties": {
        "document_type": {"const": "PUBLIC_SELECTION_CASES"},
        "format_version": {"const": 1},
        "notice": {"type": "string"},
        "registry_file": {"const": "research_selection_questions.json"},
        "cases": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/publicCase"}}
      }
    }
  }
}
