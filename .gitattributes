# Normalize source and documentation line endings for Linux compatibility.
* text=auto
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
evidence/blind/**/preregistration.jsonl text eol=lf
*.toml text eol=lf
*.sh text eol=lf

# Preserve immutable historical evidence bytes.
evidence/historical/** -text
evidence/acceptance.zip binary
